// components/tree_icon.at — TreeIcon 有界图标调色板(PLAN-614)。
//
// 独立文件原因:auto run 增量路径对多-widget .at 把同一份代码写到每个
// widget 名下(预存 bug,ToggleItem.vue 同症),单文件单 widget 绕开。
//
/// TreeIcon — 有界图标调色板渲染(PLAN-614)。
/// vue 轨 icon 只发射字面量名(动态名 → Circle 占位),故按 name 分支
/// 发射真 lucide 组件;VM 轨 lucide 表同名覆盖。调色板 = 目录族
/// (folder/folder-open/file/file-text/image)+ home/wrench/layout-grid/
/// terminal/settings/eye/book-open + PLAN-618 增 table/zap(026 对象树)。
/// 调色板外名字渲染为空(契约文档收录)。
// PLAN-001 T-05 执行内修复：stylekit 依赖内联退役——auto run 的依赖下载器
// 在索引可达（gitee 网络）时会克隆 deps/stylekit 覆盖 vendor 固定版且产物
// 缺 styles.at（tree_icon 解析炸 fatal-at-boot，本会话网络恢复触发实证）。
// 全 app 仅此一处导入；icon_base 字面量与 vendor/stylekit styles.at:28 同源。
style icon_base = "w-4 h-4 shrink-0 text-muted-foreground"

widget TreeIcon (name: str = "") {
    view {
        if .name == "folder" {
            icon (name: "folder", style: icon_base) {}
        } else {
            if .name == "folder-open" {
                icon (name: "folder-open", style: icon_base) {}
            } else {
                if .name == "file" {
                    icon (name: "file", style: icon_base) {}
                } else {
                    if .name == "file-text" {
                        icon (name: "file-text", style: icon_base) {}
                    } else {
                        if .name == "image" {
                            icon (name: "image", style: icon_base) {}
                        } else {
                            if .name == "home" {
                                icon (name: "home", style: icon_base) {}
                            } else {
                                if .name == "wrench" {
                                    icon (name: "wrench", style: icon_base) {}
                                } else {
                                    if .name == "layout-grid" {
                                        icon (name: "layout-grid", style: icon_base) {}
                                    } else {
                                        if .name == "terminal" {
                                            icon (name: "terminal", style: icon_base) {}
                                        } else {
                                            if .name == "settings" {
                                                icon (name: "settings", style: icon_base) {}
                                            } else {
                                                if .name == "eye" {
                                                    icon (name: "eye", style: icon_base) {}
                                                } else {
                                                    if .name == "book-open" {
                                                        icon (name: "book-open", style: icon_base) {}
                                                    } else {
                                                        if .name == "table" {
                                                            icon (name: "table", style: icon_base) {}
                                                        } else {
                                                            if .name == "zap" {
                                                                icon (name: "zap", style: icon_base) {}
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
